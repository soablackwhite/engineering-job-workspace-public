# Copy privately and fill only in an ignored environment file.
# Authentication values must never be committed.
JOB_WORKSPACE_CONFIG=.private/workspace.json
JOB_CRM_ORIGIN=
JOB_RECEIPT_ACCOUNT=
JOB_RESUME_MANIFEST=.private/resume/master-manifest.json
JOB_SELECTION_POLICY=.private/selection-policy.json
JOB_CANDIDATE_INDEX=.private/candidate-index.json
# App APIs remain locked until a trusted gateway and exact owner are configured.
WORKSPACE_AUTH_MODE=
WORKSPACE_OWNER_ID=
